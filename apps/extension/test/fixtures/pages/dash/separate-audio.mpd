<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT20S">
	<Period>
		<AdaptationSet contentType="video" mimeType="video/mp4">
			<SegmentTemplate initialization="init-$RepresentationID$.mp4" media="$RepresentationID$-$Number$.m4s" duration="10" startNumber="1" />
			<Representation id="hi" bandwidth="4000000" width="1920" height="1080" codecs="avc1.640028" />
		</AdaptationSet>
		<AdaptationSet contentType="audio" mimeType="audio/mp4" lang="ja">
			<SegmentTemplate initialization="init-$RepresentationID$.mp4" media="$RepresentationID$-$Number$.m4s" duration="10" startNumber="1" />
			<Representation id="lo" bandwidth="128000" codecs="mp4a.40.2" />
		</AdaptationSet>
	</Period>
</MPD>
