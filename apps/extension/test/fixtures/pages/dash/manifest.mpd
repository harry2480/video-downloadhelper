<?xml version="1.0" encoding="utf-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT20S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-on-demand:2011">
	<Period>
		<AdaptationSet contentType="video" mimeType="video/mp4" segmentAlignment="true">
			<SegmentTemplate initialization="init-$RepresentationID$.mp4" media="$RepresentationID$-$Number$.m4s" duration="10" startNumber="1" />
			<Representation id="hi" bandwidth="4000000" width="1920" height="1080" codecs="avc1.640028,mp4a.40.2" />
			<Representation id="lo" bandwidth="800000" width="640" height="360" codecs="avc1.64001f,mp4a.40.2" />
		</AdaptationSet>
	</Period>
</MPD>
