{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"apps/extension": {
			"entry": [
				"src/background/index.ts",
				"src/content/index.ts",
				"src/offscreen/index.ts",
				"src/popup/main.tsx",
				"scripts/*.mjs"
			],
			"project": "src/**/*.{ts,tsx}",
			"ignoreDependencies": ["tailwindcss"]
		}
	}
}
